# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/testing/
/tests/

# next.js
/.next/
/out/

# production
/build

# misc & OS files
.DS_Store
*.pem
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# debug & crash dumps
*.log
*.stackdump
*.dmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
