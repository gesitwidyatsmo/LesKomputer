# IDE & code editors
.vscode/
.idea/
*.swp
*.swo
*~

# caches
.eslintcache

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch / temporary files in root
/c.jpg
/download.jpg
/scratch/
*.tmp
*.temp

